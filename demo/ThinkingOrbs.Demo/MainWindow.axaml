<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:orbs="clr-namespace:ThinkingOrbs;assembly=ThinkingOrbs.Avalonia"
        x:Class="ThinkingOrbs.Demo.MainWindow"
        Title="thinking-orbs — Avalonia"
        Width="880" Height="620"
        SizeToContent="Height">

  <DockPanel Margin="24">

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
      <ToggleSwitch x:Name="ThemeSwitch" OnContent="Dark" OffContent="Light" IsChecked="True"
                    IsCheckedChanged="OnThemeToggled" />
      <ToggleButton x:Name="Pause" Content="Pause" />
      <TextBlock Text="Speed" VerticalAlignment="Center" />
      <Slider x:Name="SpeedSlider" Width="180" Minimum="0.25" Maximum="3" Value="1"
              VerticalAlignment="Center" />
      <TextBlock Text="{Binding #SpeedSlider.Value, StringFormat='{}{0:F2}x'}"
                 VerticalAlignment="Center" Width="48" />
    </StackPanel>

    <ItemsControl x:Name="Gallery">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Width="160" Margin="0,0,0,28" HorizontalAlignment="Center">
            <orbs:ThinkingOrb State="{Binding}" Size="Px64"
                              Speed="{Binding #SpeedSlider.Value}"
                              IsPaused="{Binding #Pause.IsChecked}"
                              HorizontalAlignment="Center" />
            <orbs:ThinkingOrb State="{Binding}" Size="Px20"
                              Speed="{Binding #SpeedSlider.Value}"
                              IsPaused="{Binding #Pause.IsChecked}"
                              HorizontalAlignment="Center" Margin="0,12,0,0" />
            <TextBlock Text="{Binding}" HorizontalAlignment="Center" Margin="0,10,0,0" Opacity="0.7" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

  </DockPanel>
</Window>
